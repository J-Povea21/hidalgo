#!/bin/sh
# Runs workbench's checks before a push that touches servers/workbench/.
# Pushes that don't touch it pass straight through.
# Until the team has CI this is the gate; `git push --no-verify` skips it.

top=$(git rev-parse --show-toplevel) || exit 1
zero=0000000000000000000000000000000000000000
touched=0

while read -r _local_ref local_sha _remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue
  if [ "$remote_sha" = "$zero" ]; then
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || git rev-list --max-parents=0 "$local_sha" | tail -1)
  else
    base=$remote_sha
  fi
  if git diff --name-only "$base" "$local_sha" -- servers/workbench | grep -q .; then
    touched=1
  fi
done

[ "$touched" = 0 ] && exit 0

echo "workbench: running npm run check before push..."
if ! npm --prefix "$top/servers/workbench" run --silent check; then
  echo "workbench: checks failed, push blocked. Fix them, or push with --no-verify to skip." >&2
  exit 1
fi
