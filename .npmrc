# Supply chain: every version is exact, and no dependency runs code at install time.
# pnpm 10 refuses their scripts unless allowlisted, and `pnpm run check` fails on any allowlist.
# npm would run them, so engine-strict and engines.npm in package.json make npm refuse to install,
# as engines.pnpm does for a pnpm older than 10.
save-exact=true
engine-strict=true
audit-level=high
fund=false
