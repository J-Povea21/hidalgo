{
  "name": "@j-povea21/hidalgo",
  "private": true,
  "description": "A local MCP server and page where a developer reviews, questions and approves an AI agent's work.",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20",
    "pnpm": ">=10",
    "npm": "please-use-pnpm"
  },
  "scripts": {
    "prepare": "node scripts/setup-hooks.mjs",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config config/vitest.config.ts",
    "deps": "depcruise --config config/dependency-cruiser.cjs server client shared",
    "check": "node scripts/check.mjs",
    "demo": "node scripts/demo.mjs",
    "test:browser": "node scripts/build.mjs && playwright test --config config/playwright.config.ts",
    "lint": "eslint --config config/eslint.config.mjs .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@modelcontextprotocol/sdk": "1.32.2",
    "hono": "4.13.13",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@testing-library/preact": "3.2.6",
    "@types/node": "26.6.5",
    "dependency-cruiser": "18.7.0",
    "dompurify": "3.4.17",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "happy-dom": "21.0.4",
    "marked": "18.1.1",
    "mermaid": "12.2.0",
    "preact": "11.0.2",
    "prettier": "3.9.9",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.5"
  },
  "prettier": {
    "printWidth": 120,
    "singleQuote": true,
    "trailingComma": "all",
    "arrowParens": "always"
  }
}
